# Environment Configuration
NODE_ENV=development
PORT=5000

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/teenmind

# JWT Configuration
JWT_SECRET=your-super-secure-jwt-secret-key-here
JWT_EXPIRE=7d

# Security Configuration
BCRYPT_SALT_ROUNDS=12

# ML Service Configuration
ML_SERVICE_URL=http://localhost:8000

# OpenRouter Configuration (AI Chat + AI Assessment)
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_SITE_URL=http://localhost:3001
OPENROUTER_APP_TITLE=TeenMind Mental Health Assistant

# Email Configuration (for notifications)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-email-password

# Crisis Management Configuration
EMERGENCY_ALERT_ENABLED=true
EMERGENCY_CONTACTS=911,1-988-SUICIDE

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100